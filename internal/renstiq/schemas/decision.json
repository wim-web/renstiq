{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "renstiq decision",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "merge",
        "hold"
      ]
    },
    "reason_type": {
      "type": "string",
      "enum": [
        "compatible",
        "compatibility",
        "human_review",
        "policy",
        "checks",
        "conflict",
        "resolved"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "source",
          "finding"
        ]
      },
      "minItems": 1
    },
    "review": {
      "type": "object",
      "properties": {
        "instructions_followed": {
          "type": "boolean"
        },
        "upstream_checked": {
          "type": "boolean"
        },
        "usage_checked": {
          "type": "boolean"
        },
        "no_unresolved_requests": {
          "type": "boolean"
        },
        "compatible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "instructions_followed",
        "upstream_checked",
        "usage_checked",
        "no_unresolved_requests",
        "compatible"
      ]
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependency": {
            "type": "string",
            "minLength": 1
          },
          "update_type": {
            "type": "string",
            "enum": [
              "patch",
              "minor",
              "major",
              "digest",
              "pin",
              "lockfile",
              "unknown"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "dependency",
          "update_type",
          "files"
        ]
      }
    },
    "feedback": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string",
          "minLength": 1
        },
        "equivalent_comment_id": {
          "type": "integer",
          "minimum": 1
        },
        "update_comment_id": {
          "type": "integer",
          "minimum": 1
        },
        "add_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "remove_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "post_merge": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "needed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "needed",
          "reason"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "repo",
    "pr",
    "head_sha",
    "base_sha",
    "config_digest",
    "decision",
    "reason_type",
    "reason",
    "evidence",
    "review",
    "updates",
    "post_merge"
  ]
}
