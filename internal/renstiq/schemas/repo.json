{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "renstiq repo v2",
  "description": "Repository-local policy. Rules combine PR conditions and instructions. Select the first matching enabled rule in source order; an unknown earlier rule blocks later rules. No match means excluded. Shared defaults, inheritance, separate filters and review references are not supported.",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "enabled": {
      "type": "boolean"
    },
    "github_api_read_retry": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "interval_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "respect_retry_after": {
          "type": "boolean",
          "description": "Only true permits Retry-After to increase interval_seconds. Omitted or false uses the configured interval unchanged."
        }
      },
      "additionalProperties": false,
      "description": "Optional read retries. Omitted or empty means one initial request and no retries. After merging config, max_attempts is required if any retry option is set, and interval_seconds is required for max_attempts > 1. Explicit 0 means immediate retry. max_attempts includes the initial request."
    },
    "merge": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "squash",
            "merge",
            "rebase"
          ]
        }
      },
      "additionalProperties": false
    },
    "on_blocked": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/instruction"
      }
    },
    "after_merge": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/instruction"
      }
    },
    "after_repo": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/instruction"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rule"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "definitions": {
    "match": {
      "type": "object",
      "properties": {
        "changed_files_any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "update_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "patch",
              "minor",
              "major",
              "digest",
              "pin",
              "pinDigest",
              "lockFileMaintenance",
              "lockfileUpdate",
              "replacement",
              "rollback",
              "bump"
            ]
          }
        }
      },
      "additionalProperties": false,
      "description": "Nonempty fields are ANDed. File globs match any changed path (including old rename paths) of the PR. Dependency and update type must match the same update. Empty conditions impose no restriction."
    },
    "instruction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "match": {
          "$ref": "#/definitions/match"
        },
        "exclude": {
          "$ref": "#/definitions/match"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "description": "Repository-local follow-up task. Enabled items require nonempty instructions. Empty exclude excludes nothing. The CLI does not execute tasks."
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": "At least one PR label must exactly match a listed name (case-sensitive); other PR labels are allowed. Omitted imposes no restriction; an empty list never matches. Missing or incomplete labels make this condition unknown."
        },
        "base_branches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "head_branches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "commit_authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "update_types": {
          "type": "array",
          "description": "At least one PR update must have a listed type. Other update types may coexist. Omitted imposes no restriction; an empty list never matches. Incomplete update metadata makes this condition unknown.",
          "items": {
            "type": "string",
            "enum": [
              "patch",
              "minor",
              "major",
              "digest",
              "pin",
              "pinDigest",
              "lockFileMaintenance",
              "lockfileUpdate",
              "replacement",
              "rollback",
              "bump"
            ]
          }
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "description": "A repository-local PR rule. Conditions are ANDed. Labels and update_types match any listed value present on the PR; all files, commit authors and dependency names must be allowed. Omitted lists impose no restriction; explicit empty lists never match. The first matching enabled rule supplies its complete instructions, required when enabled."
    }
  }
}
