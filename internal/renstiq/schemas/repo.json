{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "renstiq repo v2",
  "description": "Version 2 only. Named lists add new IDs in source order. Same ID defaults to override (whole-entry replacement), or inherit: merge (recursive maps, unique array union, instructions appended with a blank line, child scalars win). enabled: false disables an ID. IDs must be unique within each section of each source. Empty named lists inherit unchanged. null is invalid. After_merge follows each confirmed merge; after_repo runs once after processing the repo only when this run has confirmed at least one merge.",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "enabled": {
      "type": "boolean"
    },
    "github_api_read_retry": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "interval_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "pull_requests": {
      "type": "object",
      "properties": {
        "lock_label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/filter"
          }
        }
      },
      "additionalProperties": false
    },
    "merge": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "squash",
            "merge",
            "rebase"
          ]
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/instruction"
      }
    },
    "on_blocked": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/instruction"
      }
    },
    "after_merge": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/instruction"
      }
    },
    "after_repo": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/instruction"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "definitions": {
    "filter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "inherit": {
          "type": "string",
          "enum": [
            "merge",
            "override"
          ],
          "default": "override"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "base_branches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "head_branches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "commit_authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "update_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "patch",
              "minor",
              "major",
              "digest",
              "pin",
              "pinDigest",
              "lockFileMaintenance",
              "lockfileUpdate",
              "replacement",
              "rollback",
              "bump"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "description": "Enabled filters are ANDed. Omitted fields impose no restriction; explicit empty lists allow none. All changed paths, commit authors and dependency updates must satisfy each specified allowlist. Files/head branches are globs, other names are exact."
    },
    "match": {
      "type": "object",
      "properties": {
        "changed_files_any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "update_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "patch",
              "minor",
              "major",
              "digest",
              "pin",
              "pinDigest",
              "lockFileMaintenance",
              "lockfileUpdate",
              "replacement",
              "rollback",
              "bump"
            ]
          }
        }
      },
      "additionalProperties": false,
      "description": "Nonempty fields are ANDed. File globs match any changed path (including old rename paths) of the PR. Dependency and update type must match the same update. Empty conditions impose no restriction."
    },
    "instruction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "inherit": {
          "type": "string",
          "enum": [
            "merge",
            "override"
          ],
          "default": "override"
        },
        "match": {
          "$ref": "#/definitions/match"
        },
        "exclude": {
          "$ref": "#/definitions/match"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "description": "One AI task. All matching review entries apply. Instructions are required on enabled resolved entries. Empty exclude excludes nothing. Commands and failure handling belong in instructions; the CLI never executes tasks."
    }
  }
}
