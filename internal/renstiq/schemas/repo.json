{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "renstiq repo",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "pull_requests": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Exact allowlist. An empty array allows none. Authors only narrows the open Renovate PR population."
        },
        "base_branches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Exact allowlist. An empty array allows none."
        },
        "head_branches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "An empty array imposes no additional restriction. Glob patterns."
        },
        "commit_authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "An empty array imposes no additional restriction. Exact GitHub logins; unknown authors cannot be matched conclusively."
        }
      },
      "additionalProperties": false
    },
    "merge": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "squash",
            "merge",
            "rebase"
          ]
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "instructions_mode": {
          "type": "string",
          "enum": ["override", "merge"],
          "description": "How repository instructions combine with common defaults: override replaces them; merge appends repository instructions after a blank line. Inherits defaults.review.instructions_mode, or override if omitted there. Omitted instructions always inherit unchanged."
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Exact dependency names; empty means unrestricted."
          },
          "update_types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "patch",
                "minor",
                "major",
                "digest",
                "pin",
                "lockfile",
                "unknown"
              ]
            },
            "minItems": 1
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "files",
          "update_types"
        ]
      },
      "description": "Ordered rules: for each changed path (including both names on rename), select only the first rule whose files match. AI then evaluates that rule's dependencies, update_types, and instructions; failure must not fall through to later rules. All paths and updates must satisfy their selected rules. Place specific rules before catch-all rules. An unmatched path excludes the PR. Empty means no file restriction or additional update-specific rules, not permission to merge."
    },
    "feedback": {
      "type": "object",
      "properties": {
        "comment_on": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "compatibility",
              "human_review",
              "policy",
              "checks",
              "conflict",
              "resolved"
            ]
          },
          "description": "Allowed comment reasons for AI operations; empty permits none."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Allowed labels for AI operations; empty permits none."
        }
      },
      "additionalProperties": false
    },
    "post_merge": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "timing": {
            "type": "string",
            "enum": [
              "after_each_merge",
              "after_repo"
            ]
          },
          "match": {
            "type": "object",
            "properties": {
              "changed_files_any": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "update_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "working_dir": {
            "type": "string",
            "minLength": 1
          },
          "requires_review": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "timing",
          "command"
        ]
      },
      "description": "Commands and conditions for AI to execute when authorized; empty means no post-merge commands. No automatic stdin injection or checkout synchronization."
    },
    "working_dir": {
      "type": "string",
      "minLength": 1,
      "description": "AI post-merge working directory: command override, then this value, then repository root. Relative paths resolve from repository root; ~/ from the home directory."
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "description": "Objects recursively override inherited objects; arrays replace inherited arrays. Omitted fields inherit. null is invalid for every configuration field."
}
