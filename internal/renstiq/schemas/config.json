{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "renstiq config",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "discovery": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "interval_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "properties": {
        "poll_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "pull_requests": {
          "type": "object",
          "properties": {
            "authors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "base_branches": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "head_branches": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "commit_authors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "checks": {
          "type": "object",
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 0
            },
            "required": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "workflow": {
                    "type": "string",
                    "minLength": 1
                  },
                  "app_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "name"
                ]
              }
            },
            "all_success": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "merge": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "squash",
                "merge",
                "rebase"
              ]
            },
            "require_clean": {
              "type": "boolean"
            },
            "delete_branch": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "update_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "checks": {
                "type": "object",
                "properties": {
                  "minimum": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "required": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "workflow": {
                          "type": "string",
                          "minLength": 1
                        },
                        "app_id": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "name"
                      ]
                    }
                  },
                  "all_success": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "instructions": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "files",
              "update_types"
            ]
          }
        },
        "feedback": {
          "type": "object",
          "properties": {
            "comment_on": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "compatibility",
                  "human_review",
                  "policy",
                  "checks",
                  "conflict",
                  "resolved"
                ]
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "post_merge": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "timing": {
                "type": "string",
                "enum": [
                  "after_each_merge",
                  "after_repo"
                ]
              },
              "match": {
                "type": "object",
                "properties": {
                  "changed_files_any": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "update_types": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "working_dir": {
                "type": "string",
                "minLength": 1
              },
              "requires_review": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "timing",
              "command"
            ]
          }
        },
        "working_dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ]
}
